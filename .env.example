# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 git 에 커밋되지 않습니다.
# 서버는 환경변수만 읽습니다 — 인증키는 DB나 프런트엔드에 절대 저장하지 않습니다.
#
# Windows PowerShell 에서 한 번만 띄울 때:
#   $env:G2B_SERVICE_KEY="발급키"; npm start
# Git Bash / macOS / Linux:
#   G2B_SERVICE_KEY=발급키 npm start

# ── 나라장터(조달청) 입찰공고 ─────────────────────────────────────────────
# 공공데이터포털(data.go.kr) > "조달청_나라장터 입찰공고정보서비스" 활용신청 후
# 발급되는 '일반 인증키(Decoding)' 를 넣습니다.
# https://www.data.go.kr/data/15129394/openapi.do
G2B_SERVICE_KEY=

# ── 외부 공급처 가격/재고 연동 (선택) ────────────────────────────────────
SUPPLIER_API_TOKEN=
SUPPLIER_API_BASE_URL=
# 응답의 각 행에 supplierName이 없을 때 사용할 계약 공급처명
SUPPLIER_API_NAME=
SUPPLIER_SFTP_HOST=
SUPPLIER_SFTP_USER=
SUPPLIER_SFTP_PASSWORD=

# ── 서버 ──────────────────────────────────────────────────────────────────
# PORT=4173
# HOST=127.0.0.1
# ERP_DB_PATH=./backend/erp.db

# ── 가격비교 소스 ─────────────────────────────────────────────────────────
# 네이버 쇼핑 검색 — 응답마다 판매몰 이름(mallName)이 붙어 오므로,
# 검색 한 번으로 쇼핑몰 여러 곳의 가격이 판매처별로 나뉘어 들어옵니다.
# 발급: https://developers.naver.com/apps/#/register → '검색' API 선택 (무료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 쿠팡 파트너스 — 제휴 승인 후 발급됩니다. 쿠팡 화면은 크롤링하지 않습니다.
# 발급: https://partners.coupang.com
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 알리익스프레스 오픈 플랫폼 — robots.txt 가 상품 경로를 막으므로 공식 API 만 씁니다.
# 발급: https://openservice.aliexpress.com
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
